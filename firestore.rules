rules_version = '2';

// The public issue board. Three rules stand for all the rest:
//
//  1. Reading is public, EXCEPT what is archived.
//  2. The only public write to `issues` is `upvotes += 1`. Nothing else.
//  3. Nothing is ever deleted -- archiving IS the delete.
//
// The collection paths, the field names and the stored enum values are a
// contract with the documents already in the database, so they keep their
// Portuguese spelling. The function names are ours.
service cloud.firestore {
  match /databases/{database}/documents {

    // One operator only. `email_verified` is what blocks a token issued for an
    // unverified address that merely CLAIMS to be this e-mail.
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && request.auth.token.email == 'adsonpleal@gmail.com';
    }

    function projects() {
      return ['visuais', 'simulador', 'recap', 'mercado', 'calc'];
    }

    function statuses() {
      return ['reportado', 'backlog', 'em_progresso', 'resolvido', 'nao_sera_feito'];
    }

    // `replay` does not appear in the public form: only the simulator creates a
    // record of that type. But the admin has to be able to edit one afterwards.
    function types() {
      return ['bug', 'feature', 'replay'];
    }

    match /issues/{issueId} {

      // --- READING ------------------------------------------------------
      // `get` is evaluated against the real document: whoever kept the URL of an
      // archived card gets denied. The client has to render permission-denied
      // and not-found the same way, otherwise the difference between the two
      // answers becomes an oracle for "there is an archived card here".
      allow get: if isAdmin() || resource.data.arquivado == false;

      // `list` is evaluated against the QUERY, not against the result: a
      // security rule does not filter a collection. Anybody who is not the admin
      // has to pin `arquivado` to false in their own where, or the whole query is
      // rejected before a single document is read. That is why `arquivado` is a
      // mandatory boolean and not a sixth status -- a `!=` does not compose with
      // an orderBy on another field, and a document without the field takes the
      // board's query down for everybody.
      allow list: if isAdmin()
                  || (resource.data.arquivado == false
                      && request.query.limit <= 500);

      // --- PUBLIC CREATION ----------------------------------------------
      // Anybody opens a card. It is born in `reportado`, visible, with the
      // counters at zero and the server's clock. `origem` is left out of the
      // hasOnly on purpose: only the seed (the admin SDK, which goes over the
      // rules) writes provenance.
      allow create: if isAdminCard()
                    || isNewPublicIssue(request.resource.data)
                    || isLegacyRecording(request.resource.data);

      // Promoting a recording from the inbox is creating a card, not editing
      // one. `criadoEm` is left loose on purpose: the card enters the board with
      // the day the person recorded it, not the day triage looked at it. The
      // enums still hold -- that is what stops a status with no column from
      // existing.
      function isAdminCard() {
        return isAdmin()
               && request.resource.data.status in statuses()
               && request.resource.data.projeto in projects()
               && request.resource.data.tipo in types()
               && request.resource.data.arquivado is bool
               && request.resource.data.criadoEm is timestamp
               && request.resource.data.atualizadoEm == request.time;
      }

      // --- A RECORDING FROM "AJUDE O SIMULADOR" (THE OLD PATH) ------------
      // Replaced by the `gravacoes` collection further down: a recording became
      // input data instead of a card born archived.
      //
      // It stays here only while there is an old simulator cached out there -- a
      // submission from those versions still lands as an archived card, and
      // `tools/move-recordings.mjs` sweeps it into the new collection. Once the
      // updated simulator is live and the sweep finds nothing more, THIS GOES,
      // along with the `|| isLegacyRecording(...)` in the create above.
      function isLegacyRecording(d) {
        return d.keys().hasOnly([
                 'projeto', 'titulo', 'descricao', 'tipo', 'status',
                 'arquivado', 'upvotes', 'comentarios', 'anexos',
                 'criadoEm', 'atualizadoEm', 'autor', 'replay'
               ])
               && d.keys().hasAll([
                 'projeto', 'titulo', 'descricao', 'tipo', 'status',
                 'arquivado', 'upvotes', 'comentarios', 'anexos',
                 'criadoEm', 'atualizadoEm', 'replay'
               ])
               && d.projeto == 'simulador'
               && d.tipo == 'replay'
               && d.status == 'reportado'
               && d.arquivado == true
               && d.titulo is string
               && d.titulo.size() >= 3 && d.titulo.size() <= 120
               && d.descricao is string && d.descricao.size() <= 4000
               && d.upvotes == 0
               && d.comentarios == 0
               && d.anexos == 1
               && d.criadoEm == request.time
               && d.atualizadoEm == request.time
               // What triage reads to rank without downloading the .rrf: class,
               // levels, hits, equipment changes, traits, version.
               && d.replay is map && d.replay.size() <= 24
               && (!d.keys().hasAny(['autor'])
                   || (d.autor is string && d.autor.size() <= 40));
      }

      function isNewPublicIssue(d) {
        return d.keys().hasOnly([
                 'projeto', 'titulo', 'descricao', 'tipo', 'status',
                 'arquivado', 'upvotes', 'comentarios', 'anexos',
                 'criadoEm', 'atualizadoEm', 'autor'
               ])
               && d.keys().hasAll([
                 'projeto', 'titulo', 'descricao', 'tipo', 'status',
                 'arquivado', 'upvotes', 'comentarios', 'anexos',
                 'criadoEm', 'atualizadoEm'
               ])
               // A counter only for the card's badge. What really rules is what
               // exists in the subcollection; this number is written on creation
               // because the public cannot update the card afterwards.
               && d.anexos is int && d.anexos >= 0 && d.anexos <= 5
               && d.projeto is string && d.projeto in projects()
               // The public form does not create a recording -- that is the
               // simulator's.
               && d.tipo is string && d.tipo in ['bug', 'feature']
               && d.status == 'reportado'
               && d.arquivado == false
               && d.titulo is string
               && d.titulo.size() >= 3 && d.titulo.size() <= 120
               && d.descricao is string && d.descricao.size() <= 4000
               && d.upvotes == 0
               && d.comentarios == 0
               // The server's clock, not the caller's: it makes `criadoEm`
               // trustworthy to sort by and impossible to backdate.
               && d.criadoEm == request.time
               && d.atualizadoEm == request.time
               // The nick is optional and PUBLIC -- the form says so in the label.
               && (!d.keys().hasAny(['autor'])
                   || (d.autor is string && d.autor.size() <= 40));
      }

      // --- UPDATING ------------------------------------------------------
      allow update: if isAdmin()
                    ? (isAdminReorder() || isAdminEdit())
                    : isPublicUpvote();

      // The system's only public mutation. `increment(1)` is resolved on the
      // server BEFORE the rule runs, so the arithmetic below sees the final
      // value -- the same shape already running in production on
      // ragreplaystats. The de-duplication is localStorage and nothing else:
      // this rule exists to limit the damage (one field, +1, a visible card),
      // not to prevent gaming.
      function isPublicUpvote() {
        return resource.data.arquivado == false
               && request.resource.data.diff(resource.data)
                    .affectedKeys().hasOnly(['upvotes'])
               && request.resource.data.upvotes == resource.data.upvotes + 1;
      }

      // Dragging a card inside the stack touches only the sort key -- and on
      // purpose does NOT stamp `atualizadoEm`: "Resolvido" and the drawer sort
      // by that date, and arranging the stack is not touching the card. A
      // reorder batch hits this rule once per document; the card that changed
      // column in the same gesture carries a status along and falls to the rule
      // below.
      //
      // `hasOnly` also covers deleting the field, which is the button that goes
      // back to automatic order.
      function isAdminReorder() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['ordem'])
               && (!request.resource.data.keys().hasAny(['ordem'])
                   || request.resource.data.ordem is int);
      }

      // The admin moves, edits and archives -- but the enums still hold,
      // otherwise one wrong edit in the console writes a status with no column
      // and the card vanishes from every screen with no error at all.
      function isAdminEdit() {
        return request.resource.data.status in statuses()
               && request.resource.data.projeto in projects()
               && request.resource.data.tipo in types()
               && request.resource.data.arquivado is bool
               && (!request.resource.data.keys().hasAny(['ordem'])
                   || request.resource.data.ordem is int)
               && request.resource.data.criadoEm == resource.data.criadoEm
               && request.resource.data.atualizadoEm == request.time;
      }

      allow delete: if false;

      // --- COMMENTS ------------------------------------------------------
      // Public reading, admin-only writing: it is the changelog whoever
      // reported follows. The parent's get() is what stops an archived card's
      // comment from leaking to somebody who kept the id. It costs one extra
      // read per evaluation, and that only happens on the card's page -- never
      // on the board.
      match /comentarios/{commentId} {
        allow read: if isAdmin()
                    || get(/databases/$(database)/documents/issues/$(issueId))
                         .data.arquivado == false;

        allow create: if isAdmin()
                      && request.resource.data.keys().hasOnly(
                           ['texto', 'autor', 'autorUid', 'criadoEm', 'tipo'])
                      && request.resource.data.keys().hasAll(
                           ['texto', 'autor', 'autorUid', 'criadoEm', 'tipo'])
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() > 0
                      && request.resource.data.texto.size() <= 4000
                      && request.resource.data.autor is string
                      && request.resource.data.autor.size() <= 60
                      && request.resource.data.autorUid == request.auth.uid
                      && request.resource.data.tipo in ['comentario', 'mudanca']
                      && request.resource.data.criadoEm == request.time;

        allow update: if isAdmin()
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['texto'])
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() > 0
                      && request.resource.data.texto.size() <= 4000;

        allow delete: if false;
      }

      // --- ATTACHMENTS ----------------------------------------------------
      // One document per file, with the content in a native `bytes` field. It is
      // the same shape the simulator already uses to receive a .rrf -- and it
      // avoids depending on Cloud Storage, which would require the Blaze plan.
      //
      // The 900 kB ceiling per file is Firestore's 1 MiB per document limit
      // minus the slack for the other fields. A real .rrf is 50-100 kB; a large
      // image is shrunk in the browser before it goes up.
      match /anexos/{attachmentId} {
        // An archived card's attachment does not leak. The exists() is necessary
        // because the attachment document can be written before the card exists,
        // and get() on a non-existent document is an error, not null.
        allow read: if isAdmin()
                    || (exists(/databases/$(database)/documents/issues/$(issueId))
                        && get(/databases/$(database)/documents/issues/$(issueId))
                             .data.arquivado == false);

        // `comentarioId` is optional: when it comes, the image appears INSIDE
        // that comment instead of in the card's attachment list. That is why it
        // requires the admin -- commenting is already admin-only, and without
        // this lock anybody could make an image of theirs sprout in the middle
        // of what the admin said.
        allow create: if request.resource.data.keys().hasOnly(
                           ['nome', 'tipo', 'tamanho', 'bytes', 'criadoEm', 'comentarioId'])
                      && request.resource.data.keys().hasAll(
                           ['nome', 'tipo', 'tamanho', 'bytes', 'criadoEm'])
                      && (!request.resource.data.keys().hasAny(['comentarioId'])
                          || (isAdmin()
                              && request.resource.data.tipo == 'imagem'
                              && request.resource.data.comentarioId is string
                              && request.resource.data.comentarioId.size() > 0
                              && request.resource.data.comentarioId.size() <= 64))
                      && request.resource.data.nome is string
                      && request.resource.data.nome.size() > 0
                      && request.resource.data.nome.size() <= 200
                      && request.resource.data.tipo in ['rrf', 'imagem']
                      && request.resource.data.bytes is bytes
                      && request.resource.data.bytes.size() > 0
                      && request.resource.data.bytes.size() <= 900000
                      && request.resource.data.tamanho is int
                      && request.resource.data.tamanho == request.resource.data.bytes.size()
                      && request.resource.data.criadoEm == request.time;

        allow update: if false;
        // Here delete IS allowed, unlike everywhere else: anybody can attach a
        // file, so there has to be a way to remove what should never have come
        // in.
        allow delete: if isAdmin();
      }

      // --- THE PRIVATE CONTACT -------------------------------------------
      // Written and never read again: whoever reports can leave a Discord
      // handle or e-mail for the admin to get back to them, and that does not
      // appear on the site. The same shape as the simulator's
      // `replay_submissions` collection. A rule does not hide a field, which is
      // why the contact lives in a document of its own rather than in a column
      // of the card.
      match /privado/{docId} {
        allow read: if isAdmin();

        allow create: if request.resource.data.keys().hasOnly(['contato', 'criadoEm'])
                      && request.resource.data.keys().hasAll(['contato', 'criadoEm'])
                      && request.resource.data.contato is string
                      && request.resource.data.contato.size() > 0
                      && request.resource.data.contato.size() <= 120
                      && request.resource.data.criadoEm == request.time;

        allow update, delete: if false;
      }
    }

    // --- THE RECORDINGS FROM "AJUDE O SIMULADOR" -------------------------
    // An inbox, not a board.
    //
    // They are not cards: the simulator's dialog writes here, only the admin
    // reads, and what decides whether one becomes a public record is triage at
    // /gravacoes -- promoting CREATES an ordinary card, with the .rrf copied
    // into its attachments.
    //
    // Before that there is no URL that hands the content to anybody. It is the
    // same stance the simulator's `replay_submissions` collection took with
    // `allow read: if false`, and it is what the consent promises: the file
    // becomes a test in the open repository, not a page on a board. This used to
    // be done with a card born `arquivado`, which gave one boolean two meanings
    // -- "triage has dispatched it" and "nobody has looked yet".
    match /gravacoes/{recordingId} {
      allow read: if isAdmin();

      // A public write, like the report form: whoever uses the simulator's
      // dialog has no account at all.
      allow create: if isAdmin() || isRecordingSubmission(request.resource.data);

      function isRecordingSubmission(d) {
        return d.keys().hasOnly([
                 'titulo', 'notas', 'resumo', 'nick', 'contato',
                 'nome', 'tamanho', 'criadoEm', 'estado'
               ])
               && d.keys().hasAll(['titulo', 'resumo', 'nome', 'tamanho', 'criadoEm', 'estado'])
               // It is born in the queue. The other states are triage's stamp.
               && d.estado == 'fila'
               && d.titulo is string
               && d.titulo.size() >= 3 && d.titulo.size() <= 120
               && (!d.keys().hasAny(['notas']) || (d.notas is string && d.notas.size() <= 4000))
               // What the parser read: class, levels, hits, changes, traits.
               && d.resumo is map && d.resumo.size() <= 24
               // The nick is credit and only shows if the record is promoted;
               // the contact is a Discord handle or e-mail. Both live here
               // because the whole collection is private -- it needs none of the
               // subdocument the card requires.
               && (!d.keys().hasAny(['nick']) || (d.nick is string && d.nick.size() <= 40))
               && (!d.keys().hasAny(['contato']) || (d.contato is string && d.contato.size() <= 120))
               && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 200
               && d.tamanho is int && d.tamanho > 0 && d.tamanho <= 900000
               && d.criadoEm == request.time;
      }

      // Triage stamps what it decided. `issueId` is the card the promotion
      // created -- the only thing from here that reaches the world.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['estado', 'issueId', 'decididaEm', 'notaTriagem'])
                    && request.resource.data.estado in
                         ['fila', 'conferida', 'descartada', 'promovida'];

      // An exception to the `delete: if false` of everywhere else, for the same
      // reason as the attachments: this is a public write, so there has to be a
      // way to remove what should never have come in. Discarding (which is the
      // "archiving" of this collection) deletes nothing.
      allow delete: if isAdmin();

      // The .rrf in a document of its own, rather than in a field here, so
      // triage's list does not download hundreds of kB per row just to show the
      // summary. The same shape as `issues/{id}/anexos/{id}`, which makes the
      // promotion a copy of fields instead of a conversion.
      match /arquivo/{fileId} {
        allow read: if isAdmin();

        allow create: if isAdmin() || isRecordingFile(request.resource.data);

        function isRecordingFile(d) {
          return d.keys().hasOnly(['nome', 'tipo', 'tamanho', 'bytes', 'criadoEm'])
                 && d.keys().hasAll(['nome', 'tipo', 'tamanho', 'bytes', 'criadoEm'])
                 && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 200
                 && d.tipo == 'rrf'
                 // The same ceiling as the attachments: 1 MiB per document minus
                 // the slack.
                 && d.bytes is bytes && d.bytes.size() > 0 && d.bytes.size() <= 900000
                 && d.tamanho is int && d.tamanho == d.bytes.size()
                 && d.criadoEm == request.time;
        }

        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Everything that did not match above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
