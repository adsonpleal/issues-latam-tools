rules_version = '2';

// Quadro público de issues. Três regras valem por todo o resto:
//
//  1. Leitura é pública, MENOS o que está arquivado.
//  2. A única escrita pública em `issues` é `upvotes += 1`. Mais nada.
//  3. Nada é apagado nunca — arquivar É o delete.
service cloud.firestore {
  match /databases/{database}/documents {

    // Um operador só. `email_verified` é o que impede um token emitido para um
    // endereço não verificado que apenas ALEGA ser este e-mail.
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && request.auth.token.email == 'adsonpleal@gmail.com';
    }

    function projetos() {
      return ['visuais', 'simulador', 'recap', 'mercado', 'calc'];
    }

    function statuses() {
      return ['reportado', 'backlog', 'em_progresso', 'resolvido', 'nao_sera_feito'];
    }

    // `replay` não aparece no formulário público: só o simulador cria ficha
    // desse tipo. Mas o admin precisa poder editar uma depois.
    function tipos() {
      return ['bug', 'feature', 'replay'];
    }

    match /issues/{issueId} {

      // --- LEITURA ------------------------------------------------------
      // `get` é avaliado contra o documento real: quem guardou a URL de um
      // card arquivado leva negado. O cliente precisa renderizar
      // permission-denied e not-found do mesmo jeito, senão a diferença entre
      // as duas respostas vira um oráculo de "existe um card arquivado aqui".
      allow get: if isAdmin() || resource.data.arquivado == false;

      // `list` é avaliado contra a CONSULTA, não contra o resultado: regra de
      // segurança não filtra coleção. Quem não é admin precisa prender
      // `arquivado` em false no próprio where, ou a consulta inteira é
      // rejeitada antes de ler um único documento. É por isso que `arquivado`
      // é booleano obrigatório e não um sexto status — um `!=` não compõe com
      // o orderBy em outro campo, e um documento sem o campo derruba a
      // consulta do quadro para todo mundo.
      allow list: if isAdmin()
                  || (resource.data.arquivado == false
                      && request.query.limit <= 500);

      // --- CRIAÇÃO PÚBLICA ----------------------------------------------
      // Qualquer pessoa abre um card. Ele nasce em `reportado`, visível, com
      // os contadores zerados e o relógio do servidor. `origem` fica de fora
      // do hasOnly de propósito: só o seed (admin SDK, que passa por cima das
      // regras) escreve procedência.
      allow create: if isCardDoAdmin()
                    || isNovoIssuePublico(request.resource.data)
                    || isNovaGravacao(request.resource.data);

      // Promover uma gravação da caixa de entrada é criar card, não editar um.
      // `criadoEm` fica solto de propósito: o card entra no quadro com o dia em
      // que a pessoa gravou, não com o dia em que a triagem olhou. Os enums
      // continuam valendo — é o que impede um status sem coluna de existir.
      function isCardDoAdmin() {
        return isAdmin()
               && request.resource.data.status in statuses()
               && request.resource.data.projeto in projetos()
               && request.resource.data.tipo in tipos()
               && request.resource.data.arquivado is bool
               && request.resource.data.criadoEm is timestamp
               && request.resource.data.atualizadoEm == request.time;
      }

      // --- GRAVAÇÃO VINDA DO "AJUDE O SIMULADOR" (CAMINHO ANTIGO) ---------
      // Substituído pela coleção `gravacoes`, lá embaixo: gravação virou dado
      // de entrada em vez de card nascido arquivado.
      //
      // Continua aqui só enquanto houver simulador antigo em cache por aí — um
      // envio dessas versões ainda cai como card arquivado, e
      // `tools/mover-gravacoes.mjs` varre para a coleção nova. Depois que o
      // simulador atualizado estiver no ar e a varredura não achar mais nada,
      // ISTO SAI, junto do `|| isNovaGravacao(...)` do create acima.
      function isNovaGravacao(d) {
        return d.keys().hasOnly([
                 'projeto', 'titulo', 'descricao', 'tipo', 'status',
                 'arquivado', 'upvotes', 'comentarios', 'anexos',
                 'criadoEm', 'atualizadoEm', 'autor', 'replay'
               ])
               && d.keys().hasAll([
                 'projeto', 'titulo', 'descricao', 'tipo', 'status',
                 'arquivado', 'upvotes', 'comentarios', 'anexos',
                 'criadoEm', 'atualizadoEm', 'replay'
               ])
               && d.projeto == 'simulador'
               && d.tipo == 'replay'
               && d.status == 'reportado'
               && d.arquivado == true
               && d.titulo is string
               && d.titulo.size() >= 3 && d.titulo.size() <= 120
               && d.descricao is string && d.descricao.size() <= 4000
               && d.upvotes == 0
               && d.comentarios == 0
               && d.anexos == 1
               && d.criadoEm == request.time
               && d.atualizadoEm == request.time
               // O que a triagem lê para ranquear sem baixar o .rrf: classe,
               // níveis, golpes, trocas de equipamento, talentos, versão.
               && d.replay is map && d.replay.size() <= 24
               && (!d.keys().hasAny(['autor'])
                   || (d.autor is string && d.autor.size() <= 40));
      }

      function isNovoIssuePublico(d) {
        return d.keys().hasOnly([
                 'projeto', 'titulo', 'descricao', 'tipo', 'status',
                 'arquivado', 'upvotes', 'comentarios', 'anexos',
                 'criadoEm', 'atualizadoEm', 'autor'
               ])
               && d.keys().hasAll([
                 'projeto', 'titulo', 'descricao', 'tipo', 'status',
                 'arquivado', 'upvotes', 'comentarios', 'anexos',
                 'criadoEm', 'atualizadoEm'
               ])
               // Contador só para o selo do card. Quem manda de verdade é o que
               // existe na subcoleção; este número é escrito na criação porque
               // o público não pode atualizar o card depois.
               && d.anexos is int && d.anexos >= 0 && d.anexos <= 5
               && d.projeto is string && d.projeto in projetos()
               // O formulário público não cria gravação — isso é do simulador.
               && d.tipo is string && d.tipo in ['bug', 'feature']
               && d.status == 'reportado'
               && d.arquivado == false
               && d.titulo is string
               && d.titulo.size() >= 3 && d.titulo.size() <= 120
               && d.descricao is string && d.descricao.size() <= 4000
               && d.upvotes == 0
               && d.comentarios == 0
               // Relógio do servidor, não o de quem chama: torna `criadoEm`
               // confiável para ordenar e impossível de retrodatar.
               && d.criadoEm == request.time
               && d.atualizadoEm == request.time
               // O nick é opcional e PÚBLICO — o formulário diz isso na label.
               && (!d.keys().hasAny(['autor'])
                   || (d.autor is string && d.autor.size() <= 40));
      }

      // --- ATUALIZAÇÃO ---------------------------------------------------
      allow update: if isAdmin() ? isEdicaoAdmin() : isUpvotePublico();

      // A única mutação pública do sistema. `increment(1)` é resolvido no
      // servidor ANTES da regra rodar, então a conta abaixo enxerga o valor
      // final — é a mesma forma que já roda em produção no ragreplaystats.
      // O de-duplicado é localStorage e só: esta regra existe para limitar o
      // estrago (um campo, +1, card visível), não para impedir gamificação.
      function isUpvotePublico() {
        return resource.data.arquivado == false
               && request.resource.data.diff(resource.data)
                    .affectedKeys().hasOnly(['upvotes'])
               && request.resource.data.upvotes == resource.data.upvotes + 1;
      }

      // O admin move, edita e arquiva — mas os enums continuam valendo, senão
      // uma edição errada no console escreve um status sem coluna e o card
      // some de todas as telas sem erro nenhum.
      function isEdicaoAdmin() {
        return request.resource.data.status in statuses()
               && request.resource.data.projeto in projetos()
               && request.resource.data.tipo in tipos()
               && request.resource.data.arquivado is bool
               && request.resource.data.criadoEm == resource.data.criadoEm
               && request.resource.data.atualizadoEm == request.time;
      }

      allow delete: if false;

      // --- COMENTÁRIOS ---------------------------------------------------
      // Leitura pública, escrita só do admin: é o changelog que quem reportou
      // acompanha. O get() do pai é o que impede comentário de card arquivado
      // de vazar para quem guardou o id. Custa uma leitura extra por avaliação,
      // e isso só acontece na página do card — nunca no quadro.
      match /comentarios/{comentarioId} {
        allow read: if isAdmin()
                    || get(/databases/$(database)/documents/issues/$(issueId))
                         .data.arquivado == false;

        allow create: if isAdmin()
                      && request.resource.data.keys().hasOnly(
                           ['texto', 'autor', 'autorUid', 'criadoEm', 'tipo'])
                      && request.resource.data.keys().hasAll(
                           ['texto', 'autor', 'autorUid', 'criadoEm', 'tipo'])
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() > 0
                      && request.resource.data.texto.size() <= 4000
                      && request.resource.data.autor is string
                      && request.resource.data.autor.size() <= 60
                      && request.resource.data.autorUid == request.auth.uid
                      && request.resource.data.tipo in ['comentario', 'mudanca']
                      && request.resource.data.criadoEm == request.time;

        allow update: if isAdmin()
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['texto'])
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() > 0
                      && request.resource.data.texto.size() <= 4000;

        allow delete: if false;
      }

      // --- ANEXOS ---------------------------------------------------------
      // Um documento por arquivo, com o conteúdo num campo `bytes` nativo. É a
      // mesma forma que o simulador já usa para receber .rrf — e evita depender
      // do Cloud Storage, que exigiria plano Blaze.
      //
      // O teto de 900 kB por arquivo é o limite de 1 MiB por documento do
      // Firestore menos a folga dos outros campos. .rrf de verdade fica em
      // 50–100 kB; imagem grande é reduzida no navegador antes de subir.
      match /anexos/{anexoId} {
        // Anexo de card arquivado não vaza. O exists() é necessário porque o
        // documento do anexo pode ser gravado antes do card existir, e get()
        // em documento inexistente é erro, não null.
        allow read: if isAdmin()
                    || (exists(/databases/$(database)/documents/issues/$(issueId))
                        && get(/databases/$(database)/documents/issues/$(issueId))
                             .data.arquivado == false);

        // `comentarioId` é opcional: quando vem, a imagem aparece DENTRO daquele
        // comentário em vez de na lista de anexos do card. Por isso ela exige
        // admin — comentar já é só do admin, e sem esta trava qualquer pessoa
        // faria uma imagem sua brotar no meio da fala dele.
        allow create: if request.resource.data.keys().hasOnly(
                           ['nome', 'tipo', 'tamanho', 'bytes', 'criadoEm', 'comentarioId'])
                      && request.resource.data.keys().hasAll(
                           ['nome', 'tipo', 'tamanho', 'bytes', 'criadoEm'])
                      && (!request.resource.data.keys().hasAny(['comentarioId'])
                          || (isAdmin()
                              && request.resource.data.tipo == 'imagem'
                              && request.resource.data.comentarioId is string
                              && request.resource.data.comentarioId.size() > 0
                              && request.resource.data.comentarioId.size() <= 64))
                      && request.resource.data.nome is string
                      && request.resource.data.nome.size() > 0
                      && request.resource.data.nome.size() <= 200
                      && request.resource.data.tipo in ['rrf', 'imagem']
                      && request.resource.data.bytes is bytes
                      && request.resource.data.bytes.size() > 0
                      && request.resource.data.bytes.size() <= 900000
                      && request.resource.data.tamanho is int
                      && request.resource.data.tamanho == request.resource.data.bytes.size()
                      && request.resource.data.criadoEm == request.time;

        allow update: if false;
        // Aqui delete é permitido, ao contrário do resto: qualquer pessoa anexa
        // arquivo, então precisa existir um jeito de tirar o que não devia ter
        // entrado.
        allow delete: if isAdmin();
      }

      // --- CONTATO PRIVADO -----------------------------------------------
      // Escreve e nunca mais lê: quem reporta pode deixar Discord/e-mail para
      // o admin dar retorno, e isso não aparece no site. Mesma forma da
      // coleção `replay_submissions` do simulador. Regra não esconde campo, por
      // isso o contato mora num documento à parte em vez de numa coluna do card.
      match /privado/{docId} {
        allow read: if isAdmin();

        allow create: if request.resource.data.keys().hasOnly(['contato', 'criadoEm'])
                      && request.resource.data.keys().hasAll(['contato', 'criadoEm'])
                      && request.resource.data.contato is string
                      && request.resource.data.contato.size() > 0
                      && request.resource.data.contato.size() <= 120
                      && request.resource.data.criadoEm == request.time;

        allow update, delete: if false;
      }
    }

    // --- GRAVAÇÕES DO "AJUDE O SIMULADOR" --------------------------------
    // Caixa de entrada, não quadro.
    //
    // Elas não são card: o diálogo do simulador escreve aqui, só o admin lê, e
    // quem decide se aquilo vira ficha pública é a triagem em /admin/gravacoes
    // — promover CRIA um card normal, com o .rrf copiado para os anexos dele.
    //
    // Antes disso não existe URL que devolva o conteúdo para ninguém. É a mesma
    // postura que a coleção `replay_submissions` do simulador tinha com
    // `allow read: if false`, e é o que o consentimento promete: o arquivo vira
    // teste no repositório aberto, não uma página num quadro. Antes isso era
    // feito com um card nascendo `arquivado`, o que dava dois significados para
    // o mesmo booleano — "a triagem já despachou" e "ninguém olhou ainda".
    match /gravacoes/{gravacaoId} {
      allow read: if isAdmin();

      // Escrita pública, como o formulário de reportar: quem usa o diálogo do
      // simulador não tem conta nenhuma.
      allow create: if isAdmin() || isEnvioDeGravacao(request.resource.data);

      function isEnvioDeGravacao(d) {
        return d.keys().hasOnly([
                 'titulo', 'notas', 'resumo', 'nick', 'contato',
                 'nome', 'tamanho', 'criadoEm', 'estado'
               ])
               && d.keys().hasAll(['titulo', 'resumo', 'nome', 'tamanho', 'criadoEm', 'estado'])
               // Nasce na fila. Os outros estados são carimbo da triagem.
               && d.estado == 'fila'
               && d.titulo is string
               && d.titulo.size() >= 3 && d.titulo.size() <= 120
               && (!d.keys().hasAny(['notas']) || (d.notas is string && d.notas.size() <= 4000))
               // O que o parser leu: classe, níveis, golpes, trocas, talentos.
               && d.resumo is map && d.resumo.size() <= 24
               // Nick é crédito e só aparece se a ficha for promovida; contato é
               // Discord/e-mail. Os dois ficam aqui porque a coleção inteira é
               // privada — não precisa do subdocumento que o card exige.
               && (!d.keys().hasAny(['nick']) || (d.nick is string && d.nick.size() <= 40))
               && (!d.keys().hasAny(['contato']) || (d.contato is string && d.contato.size() <= 120))
               && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 200
               && d.tamanho is int && d.tamanho > 0 && d.tamanho <= 900000
               && d.criadoEm == request.time;
      }

      // A triagem carimba o que decidiu. `issueId` é o card que a promoção
      // criou — a única coisa daqui que chega ao mundo.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['estado', 'issueId', 'decididaEm', 'notaTriagem'])
                    && request.resource.data.estado in
                         ['fila', 'conferida', 'descartada', 'promovida'];

      // Exceção ao `delete: if false` do resto, pela mesma razão dos anexos:
      // isto é escrita pública, então precisa existir como tirar o que não
      // devia ter entrado. Descartar (que é o "arquivar" daqui) não apaga nada.
      allow delete: if isAdmin();

      // O .rrf num documento à parte, e não num campo daqui, para a lista da
      // triagem não baixar centenas de kB por linha só para mostrar o resumo.
      // Mesmo formato de `issues/{id}/anexos/{id}`, o que faz a promoção ser
      // uma cópia de campos em vez de uma conversão.
      match /arquivo/{arquivoId} {
        allow read: if isAdmin();

        allow create: if isAdmin() || isArquivoDeGravacao(request.resource.data);

        function isArquivoDeGravacao(d) {
          return d.keys().hasOnly(['nome', 'tipo', 'tamanho', 'bytes', 'criadoEm'])
                 && d.keys().hasAll(['nome', 'tipo', 'tamanho', 'bytes', 'criadoEm'])
                 && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 200
                 && d.tipo == 'rrf'
                 // Mesmo teto dos anexos: 1 MiB por documento menos a folga.
                 && d.bytes is bytes && d.bytes.size() > 0 && d.bytes.size() <= 900000
                 && d.tamanho is int && d.tamanho == d.bytes.size()
                 && d.criadoEm == request.time;
        }

        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Tudo que não casou acima é negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
