# Announces the public board's new cards on Discord.
#
# Do NOT enable this service: the one with a life cycle is issues-discord.timer,
# which fires this unit every 2 min. That is why there is no [Install] here.
#
# Manual provisioning needed once (the deploy does NOT do it):
#   install -d -o ubuntu -g ubuntu /opt/issues-discord /var/lib/issues-discord
#   infra/configure-token.sh   -> drop-in 10-token.conf (DISCORD_BOT_TOKEN)
#   infra/configure-ntfy.sh    -> drop-in 20-ntfy.conf  (NTFY_TOPICO)
#   systemctl start issues-discord.service   # bootstrap, announces NOTHING
#   systemctl enable --now issues-discord.timer
#
# Type=oneshot instead of a resident process is the central decision: a hung
# fetch dies on TimeoutStartSec and the next tick starts with a clean process and
# socket. A poller with setInterval stays green in `systemctl status` forever
# while the announcements stop in silence, which is the failure mode nobody
# notices. As a bonus, between one tick and the next the memory footprint is
# zero, which matters on a 2 GB machine with five services.
#
# No Restart=: systemd refuses Restart=always on Type=oneshot, and it is not
# missed -- the timer already tries again in 120 s.
#
# The environment variable names are a contract with the deployed unit's
# drop-ins, and the Description is what `systemctl` shows the operator, so both
# keep their spelling.

[Unit]
Description=issues-discord — anuncia no Discord os cards novos do quadro
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/issues-discord

Environment=NODE_ENV=production
Environment=FIREBASE_PROJECT_ID=issues-latam-tools
# A public web key: it already ships in the site's bundle (src/lib/firebase.ts).
# It is not a secret -- what rules access are the Firestore rules. The service
# queries WITHOUT AUTHENTICATION on purpose: that way it cannot read the
# reporter's contact even by accident.
Environment=FIREBASE_API_KEY=AIzaSyCcBw2edbq0x15csy4h4w_ZBZOGnpNvBro
Environment=DISCORD_CHANNEL_ID=1538690478751354880
Environment=SITE_URL=https://issues.latam-tools.com.br
# ⚠ OUTSIDE /opt: the deploy erases whatever is not in the tarball, and would
# take the watermark with it -- the service would re-announce everything on
# every deploy.
Environment=ESTADO=/var/lib/issues-discord/estado.json
# The DISCORD_BOT_TOKEN comes from the 10-token.conf drop-in, mode 0600, which
# does not go to the repository: this unit is public.
#
# The NTFY_TOPICO comes from 20-ntfy.conf, for the same reason -- an ntfy topic
# is the password of whoever publishes to it. It is how the deadman warns when
# the problem is Discord itself, which is exactly what happened on 20/10/2026 and
# went thirteen days without anybody knowing, because the only warning went to
# the channel that was broken. Without it the service runs the same; it just
# loses that output.

ExecStart=/usr/bin/env node --max-old-space-size=64 /opt/issues-discord/tools/announce-discord.mjs

# A ceiling under the timer's interval: it guarantees two are never running together.
TimeoutStartSec=120

# A shared machine: nothing here may take the neighbours down.
MemoryMax=128M
CPUWeight=20
IOWeight=20
Nice=10

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/issues-discord

StandardOutput=journal
StandardError=journal
SyslogIdentifier=issues-discord
