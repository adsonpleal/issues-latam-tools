# Relógio do anunciador. É este que se habilita, não o serviço.
#
#   systemctl enable --now issues-discord.timer
#   systemctl list-timers issues-discord.timer --all
#
# 120 s e não 60 s: a cota do Firestore não é o limite (720 execuções/dia dão
# ~1,5k leituras contra as 50k do plano gratuito), mas o systemd loga
# "Starting/Finished" a cada disparo e não há como calar isso por unit. A 60 s
# são ~2.880 linhas/dia de ruído no journal; a 120 s, metade. O atraso que isso
# custa num anúncio de report não muda nada para ninguém.

[Unit]
Description=issues-discord — dispara o anunciador a cada 2 min

[Timer]
OnBootSec=2min
OnUnitActiveSec=120s
AccuracySec=15s
RandomizedDelaySec=15s
# Persistent=false de propósito: o marco d'água está no disco, então uma execução
# perdida (máquina desligada, deploy) se recupera sozinha no tique seguinte —
# não há nada a "repor" com uma rajada na volta.
Persistent=false
Unit=issues-discord.service

[Install]
WantedBy=timers.target
