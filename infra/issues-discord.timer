# The announcer's clock. This is the one you enable, not the service.
#
#   systemctl enable --now issues-discord.timer
#   systemctl list-timers issues-discord.timer --all
#
# 120 s and not 60 s: the Firestore quota is not the limit (720 runs/day make
# ~1.5k reads against the free plan's 50k), but systemd logs "Starting/Finished"
# on every trigger and there is no way to silence that per unit. At 60 s that is
# ~2,880 lines/day of noise in the journal; at 120 s, half. The delay that costs
# a report's announcement changes nothing for anybody.
#
# The Description is what `systemctl` shows the operator, so it stays in
# Portuguese.

[Unit]
Description=issues-discord — dispara o anunciador a cada 2 min

[Timer]
OnBootSec=2min
OnUnitActiveSec=120s
AccuracySec=15s
RandomizedDelaySec=15s
# Persistent=false on purpose: the watermark is on disk, so a missed run (the
# machine off, a deploy) recovers by itself on the next tick -- there is nothing
# to "make up" with a burst on the way back.
Persistent=false
Unit=issues-discord.service

[Install]
WantedBy=timers.target
