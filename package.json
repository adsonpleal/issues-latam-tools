{
  "name": "issues-latam-tools",
  "version": "1.12.0",
  "private": true,
  "type": "module",
  "description": "Public issue board for the RO LATAM tools",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "import": "node tools/import-spreadsheets.mjs",
    "seed": "node tools/seed.mjs",
    "announce": "node tools/announce-discord.mjs",
    "move-recordings": "node tools/move-recordings.mjs",
    "triage": "node tools/triage.mjs",
    "listen": "node tools/listen.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^2.1.8"
  }
}
